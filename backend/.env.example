# AquaResponse Backend — Environment Variables
# Copy this file to .env and fill in values for your environment.

# ── Data paths ────────────────────────────────────────────────────────────────
# Absolute or project-relative paths to the required data files.
# Defaults point to the standard monorepo layout — override only if needed.

RISK_SCORES_PATH=../ml/artifacts/risk_scores.geojson
HYDRANTS_PATH=../data/ca_hydrants_osm.geojson
LAKES_PATH=../data/lakes/California_Lakes.shp
INCIDENTS_PATH=../data/California_Fire_Incidents.csv

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow all.
# In production, restrict this to your Vercel frontend URL.
# Example: CORS_ORIGINS=https://aquaresponse.vercel.app
CORS_ORIGINS=*
